generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  unit        String?
  description String?
  cost        Decimal  @default(0) @db.Decimal(10, 2)
  markupPct   Decimal  @default(0) @db.Decimal(5, 2)
  bundleQty   Int?
  bundleMarkdownPct Decimal? @db.Decimal(5, 2)
  bundlePrice Decimal? @db.Decimal(10, 2)
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  usesGlobalMarkup Boolean @default(true)
  isPinned    Boolean  @default(false)
  allowCustomPrice Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@index([isActive, name, id])
}

model Order {
  id           String      @id @default(cuid())
  orderNo      String      @unique
  status       OrderStatus @default(PAID)
  total        Decimal     @db.Decimal(10, 2)
  amountPaid   Decimal?    @db.Decimal(10, 2)
  refundAmount Decimal?    @db.Decimal(10, 2)
  refundedAt   DateTime?
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  items OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id               String  @id @default(cuid())
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  lineTotal        Decimal @db.Decimal(10, 2)
  productName      String
  returnedQuantity Int     @default(0)

  orderId   String
  productId String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id            String       @id @default(cuid())
  productId     String
  movementType  MovementType
  quantityDelta Int
  previousStock Int
  newStock      Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model ImportLog {
  id          String   @id @default(cuid())
  fileHash    String   @unique
  rowCount    Int
  productCount Int
  successCount Int
  failureCount Int
  createdAt   DateTime @default(now())
}

model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  userAgent     String?
  failCount     Int      @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LoadMarkupSetting {
  id          String   @id
  tier1Max    Float
  tier1Markup Float
  tier2Max    Float
  tier2Markup Float
  tier3Markup Float
  updatedAt   DateTime @updatedAt
}

model EWalletFeeSetting {
  id        String   @id
  tier1Max  Float
  tier1Fee  Float
  tier2Max  Float
  tier2Fee  Float
  tier3Fee  Float
  updatedAt DateTime @updatedAt
}

model LoadItem {
  id          String           @id @default(cuid())
  sku         String           @unique
  brand       LoadBrand
  group       LoadNetworkGroup
  category    LoadCategory
  code        String
  amount      Decimal          @db.Decimal(10, 2)
  label       String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, brand])
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  VOIDED
}

enum MovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  BULK_IMPORT
}

enum LoadBrand {
  GLOBE
  TM
  SMART
  TNT
  DITO
}

enum LoadNetworkGroup {
  GLOBE_TM
  SMART_TNT
  DITO
}

enum LoadCategory {
  REGULAR_LOAD
  DATA_PROMO
}
