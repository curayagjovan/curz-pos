generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id               String          @id @default(cuid())
  sku              String          @unique
  name             String
  unit             String?
  category         ProductCategory @default(OTHER)
  description      String?
  cost             Decimal         @default(0) @db.Decimal(10, 2)
  markupPct        Decimal         @default(0) @db.Decimal(5, 2)
  price            Decimal         @db.Decimal(10, 2)
  stock            Int             @default(0)
  isActive         Boolean         @default(true)
  usesGlobalMarkup Boolean         @default(true)
  isPinned         Boolean         @default(false)
  allowCustomPrice Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  bundleTiers        BundleTier[]

  @@index([isActive, name, id])
}

model BundleTier {
  id        String  @id @default(cuid())
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, quantity])
  @@index([productId])
}

model Order {
  id           String      @id @default(cuid())
  orderNo      String      @unique
  status       OrderStatus @default(PAID)
  total        Decimal     @db.Decimal(10, 2)
  amountPaid   Decimal?    @db.Decimal(10, 2)
  refundAmount Decimal?    @db.Decimal(10, 2)
  refundedAt   DateTime?
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  cashierId String?
  cashier   AppUser? @relation(fields: [cashierId], references: [id], onDelete: SetNull)

  items OrderItem[]

  @@index([createdAt])
  @@index([customerId, status])
  @@index([cashierId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive, name])
}

model OrderItem {
  id               String  @id @default(cuid())
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)
  lineTotal        Decimal @db.Decimal(10, 2)
  productName      String
  returnedQuantity Int     @default(0)

  orderId   String
  productId String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model InventoryMovement {
  id            String       @id @default(cuid())
  productId     String
  movementType  MovementType
  quantityDelta Int
  previousStock Int
  newStock      Int
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([referenceType, referenceId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  summary    String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ImportLog {
  id           String   @id @default(cuid())
  fileHash     String   @unique
  rowCount     Int
  productCount Int
  successCount Int
  failureCount Int
  createdAt    DateTime @default(now())
}

model PushSubscription {
  id            String    @id @default(cuid())
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  failCount     Int       @default(0)
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model LoadMarkupSetting {
  id          String   @id
  tier1Max    Float
  tier1Markup Float
  tier2Max    Float
  tier2Markup Float
  tier3Markup Float
  updatedAt   DateTime @updatedAt
}

model EWalletFeeSetting {
  id        String   @id
  tier1Fee  Float    @default(5)
  tier2Fee  Float    @default(10)
  tier3Fee  Float    @default(15)
  tier4Fee  Float    @default(20)
  stepFee   Float    @default(10)
  updatedAt DateTime @updatedAt
}

model LoadItem {
  id          String           @id @default(cuid())
  sku         String           @unique
  brand       LoadBrand
  group       LoadNetworkGroup
  category    LoadCategory
  code        String
  amount      Decimal          @db.Decimal(10, 2)
  label       String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([isActive, brand])
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  VOIDED
}

enum MovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  BULK_IMPORT
}

enum LoadBrand {
  GLOBE
  TM
  SMART
  TNT
  DITO
}

enum LoadNetworkGroup {
  GLOBE_TM
  SMART_TNT
  DITO
}

enum LoadCategory {
  REGULAR_LOAD
  DATA_PROMO
}

enum ProductCategory {
  SNACKS
  BEVERAGES
  COFFEE
  ALCOHOL
  CONDIMENTS
  CANNED_GOODS
  GROCERY_STAPLES
  DAIRY
  PERSONAL_CARE
  FEMININE_CARE
  BABY_CARE
  MEDICINE
  HOUSEHOLD
  SCHOOL_OFFICE_SUPPLIES
  LOAD_AND_PROMO
  OTHER
}

model SmsRecipientSetting {
  id        String   @id
  number    String
  updatedAt DateTime @updatedAt
}

enum AppRole {
  OWNER
  CASHIER
}

enum AppPermission {
  VOID_REFUND
  MANAGE_PRODUCTS
  MANAGE_LOAD_ITEMS
  MANAGE_SETTINGS
  MANAGE_STAFF
  VIEW_AUDIT_LOG
}

model AppUser {
  id          String          @id @default(cuid())
  authUserId  String?         @unique
  email       String          @unique
  displayName String?
  role        AppRole         @default(CASHIER)
  permissions AppPermission[] @default([])
  isActive    Boolean         @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  orders Order[]
}
