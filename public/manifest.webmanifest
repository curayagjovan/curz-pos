{
  "name": "SHOPMAE",
  "short_name": "SHOPMAE",
  "description": "Fast, installable point-of-sale web app.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "id": "/",
  "background_color": "#1c1c1e",
  "theme_color": "#f2f2f7",
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
